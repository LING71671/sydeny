# ==============================================================================
# Whitelist open-source PDFs, markdown chapters, web reader, scripts, and datasets
# ==============================================================================

# 1. Ignore everything by default
*

# 2. Allow directory traversal
!*/

# 3. Whitelist repository meta, web page & documentation
!README.md
!.gitignore
!LICENSE
!requirements.txt
!index.html
!assets/
!assets/**
!docs/
!docs/**
!markdown/
!markdown/**
!sydney_gradio_colab.ipynb
!dataset/
!dataset/**
!run_sydney.py
!run_sydney.bat
!run_sydney.ps1
!web_ui.py
!run_web_ui.bat
!scripts/
!scripts/**

# 4. Whitelist the two PDF publications
!融化成风的银针.pdf
!Sydney_哲学对话实录_全七场.pdf

# 5. Explicitly ignore all local training runs, weights, environments, and temporary experiments
base_model/
models/
.venv/
venv/
env/
runs/
frozen_v2_core/
hf_release/
hf_gguf_release/
merged_model/
llama_cpp/
space_sydney/
